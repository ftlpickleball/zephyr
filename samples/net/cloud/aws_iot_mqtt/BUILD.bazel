load("@bazel_skylib//lib:selects.bzl", "selects")
load("//bazel:cc.bzl", "zephyr_app", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

zephyr_cc_library(
    name = "main",
    visibility = ["//visibility:private"],
    srcs = ["src/main.c"],
    hdrs = glob(["**/*.h"], allow_empty = True),
)

zephyr_app(
    name = "aws_iot_mqtt",
    deps = [":main"],
)
