load("//bazel:cc.bzl", "zephyr_app", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

zephyr_cc_library(
    name = "main",
    srcs = ["src/main.c"],
    hdrs = glob(["**/*.h"], allow_empty = True),
    visibility = ["//visibility:private"],
)

zephyr_app(
    name = "blinky",
    deps = [":main"],
)
