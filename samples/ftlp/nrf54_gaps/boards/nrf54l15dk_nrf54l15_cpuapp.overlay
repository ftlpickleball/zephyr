 *
 * Build-only: pins are placeholders, not a DK wiring.
 */

#include <zephyr/dt-bindings/comparator/nrf-comp.h>
#include <zephyr/dt-bindings/sensor/lps2xdf.h>

&comp {
	main-mode = "SE";
	psel = <NRF_COMP_AIN4>;
	refsel = "INT_1V2";
	sp-mode = "HIGH";
	th-up = <63>;
	th-down = <59>;
	isource = "DISABLED";
	status = "okay";
};

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 12)>,
				<NRF_PSEL(TWIM_SCL, 1, 13)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	lps22hb: lps22hb-press@5c {
		compatible = "st,lps22hb-press";
		reg = <0x5c>;
	};

	lps22df: lps22df@5d {
		compatible = "st,lps22df";
		reg = <0x5d>;
		odr = <LPS2xDF_DT_ODR_10HZ>;
		lpf = <LPS2xDF_DT_LP_FILTER_ODR_4>;
		avg = <LPS2xDF_DT_AVG_128_SAMPLES>;
	};

	npm1304: pmic@6b {
		compatible = "nordic,npm1304";
		reg = <0x6b>;

		npm1304_charger: charger {
			compatible = "nordic,npm1304-charger";
			term-microvolt = <4150000>;
			term-warm-microvolt = <4000000>;
			current-microamp = <4000>;
			vbus-limit-microamp = <500000>;
			thermistor-ohms = <10000>;
			thermistor-beta = <3380>;
			charging-enable;
		};
	};
};
