load("@zephyr//bazel:defs.bzl", "dts_cc_library", "dts_library")
load("@zephyr//bazel:flags.bzl", "flags_from_dict")

package(default_visibility = ["//visibility:public"])

platform(
    name = "native",
    constraint_values = [
        "@zephyr//boards:sim",
        "@pigweed//pw_build/constraints/rtos:zephyr",
        "@pigweed//pw_build/constraints/rust:no_std",
    ],
    flags = flags_from_dict({
        "@rules_rust//rust/settings:extra_rustc_flags": "-Cpanic=abort",
        "@zephyr//:board_deps": "@zephyr//boards/native/native_sim:board_support",
        "@zephyr//:dt_binding_headers_library": "@rules_cc//:empty_lib",
        "@zephyr//:dts_cc_library": "//boards/vendor/custom_sim:devicetree_generated",
        "@zephyr//:extra_linker_includes": "@rules_cc//:empty_lib",
        "@zephyr//:hal_soc_headers_library": "@zephyr//soc/native/inf_clock:soc_headers",
        "@zephyr//:soc": "@zephyr//soc/native/inf_clock:soc_sources",
    }),
    parents = ["@zephyr//platforms:posix"],
)

alias(
    name = "custom_sim",
    actual = ":native",
)

dts_library(
    name = "custom_sim_dts",
    includes = [
        "@zephyr//dts:dts_includes",
        "@zephyr//include:include_includes",
    ],
    overlay = "custom_sim.dts",
    references = [
        "@zephyr//dts/posix",
        "@zephyr//dts/common",
        "@zephyr//include:dt_bindings",
    ],
)

dts_cc_library(
    name = "devicetree_generated",
    bindings = ["@zephyr//dts:bindings"],
    dts_lib = ":custom_sim_dts",
)
