load("@zephyr//bazel:cc.bzl", "zephyr_app", "zephyr_cc_library")
load("@zephyr//bazel:sysbuild.bzl", "zephyr_sysbuild")

package(default_visibility = ["//visibility:public"])

zephyr_cc_library(
    name = "lib",
    srcs = ["src/main.c"],
    deps = ["//modules/sample_mod"],
)

zephyr_app(
    name = "main_app",
    deps = [":lib"],
)

zephyr_sysbuild(
    name = "main_sysbuild",
    main = ":main_app",
)
