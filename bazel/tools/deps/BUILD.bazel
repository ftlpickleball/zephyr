load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "input_recorder.py",
])

py_library(
    name = "input_recorder_lib",
    srcs = ["input_recorder.py"],
    imports = ["."],
)

py_test(
    name = "input_recorder_test",
    srcs = ["input_recorder_test.py"],
    deps = [":input_recorder_lib"],
)

# Audits the inputs recorded for the Zephyr repositories and module extensions:
#   bazel run @zephyr//bazel/tools/deps:audit_recorded_inputs -- $(bazel info output_base)
py_binary(
    name = "audit_recorded_inputs",
    srcs = ["audit_recorded_inputs.py"],
    imports = ["."],
)

py_test(
    name = "audit_recorded_inputs_test",
    srcs = [
        "audit_recorded_inputs.py",
        "audit_recorded_inputs_test.py",
    ],
    imports = ["."],
)
