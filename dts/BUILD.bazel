load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "bindings",
    srcs = glob([
        "bindings/**/*.yaml",
        "bindings/vendor-prefixes.txt",
    ], allow_empty = True),
)

cc_library(
    name = "dts_includes",
    includes = [
        ".",
        "arm",
        "common",
        "riscv",
        "rx",
        "sparc",
        "vendor",
        "x86",
        "xtensa",
    ],
)
