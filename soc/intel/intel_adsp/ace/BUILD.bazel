zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":noinit.ld.target",
    ],
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "noinit.ld.target",
    srcs = ["noinit.ld"],
    location = "NOINIT",
    sort_key = "default",
)
