load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "common",
    srcs = [
    ] + select({
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [],
        "//conditions:default": [
            "soc_pmc.c",
        ],
    }) + select({
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [],
        "//conditions:default": [
            "soc_gpio.c",
        ],
    }) + select({
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [],
        "//conditions:default": [
            "soc_supc.c",
        ],
    }) + select({
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [],
        "//conditions:default": [
            "soc_power.c",
        ],
    }) + select({
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [],
        "//conditions:default": [
            "soc_poweroff.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [
            "soc_sam4l_pm.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [
            "soc_sam4l_gpio.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAM4L=true": [
            "soc_sam4l_poweroff.c",
        ],
    }),
)

cc_library(
    name = "common_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)
