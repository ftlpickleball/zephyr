load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "common",
    srcs = [
        "soc_port.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_BOOTLOADER_BOSSA=true": [
            "bossa.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMC20=true": [
            "soc_samc2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMC21=true": [
            "soc_samc2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMD20=true": [
            "soc_samd2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMD21=true": [
            "soc_samd2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMR21=true": [
            "soc_samd2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAML21=true": [
            "soc_saml2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMR34=true": [
            "soc_saml2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMR35=true": [
            "soc_saml2x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_ATMEL_SAMR3X_RADIO_OFF_SETUP=true": [
            "soc_samr3x_radio_off.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMD51=true": [
            "soc_samd5x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAME51=true": [
            "soc_samd5x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAME53=true": [
            "soc_samd5x.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAME54=true": [
            "soc_samd5x.c",
        ],
    }),
)

cc_library(
    name = "common_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)
