load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(
        ["*.h", "common/*.h"],
        allow_empty = True,
    ),
    includes = [".", "common"],
    visibility = ["//visibility:public"],
)

zephyr_soc_library(
    name = "max32",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_CPU_HAS_CUSTOM_FIXED_SOC_MPU_REGIONS=true": [
            "mpu_regions.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_PM=true": [
            "power.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_MAX32657=true": [
            "max32657/pm_max32657_s2ram.c",
        ],
    }),
    hdrs = glob(
        ["*.h", "common/*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = [".", "common"],
    visibility = ["//visibility:public"],
    deps = select({
        "@zephyr_kconfig//:CONFIG_RISCV=true": [":max32_config_riscv_deps"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "max32_config_riscv_deps",
    srcs = [
        "soc_irq_rv32.S",
        "vector_rv32.S",
    ],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//:autoconf_library",
        "//:hal_soc_headers_library",
        "//:offsets_header_lib",
        "//include:zephyr",
    ],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":flash.ld.target",
    ] + select({
        ":config_soc_max78000_or_config_soc_max78002": [":linker_fragments_config_soc_max78000_or_config_soc_max78002_deps"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "flash.ld.target",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_SOC_FLASH_MAX32=true": ["flash.ld"],
        "//conditions:default": [],
    }),
    location = "RAMFUNC_SECTION",
    sort_key = "default",
)

selects.config_setting_group(
    name = "config_soc_max78000_or_config_soc_max78002",
    match_any = [
        "@zephyr_kconfig//:CONFIG_SOC_MAX78000=true",
        "@zephyr_kconfig//:CONFIG_SOC_MAX78002=true",
    ],
)

zephyr_linker_fragment(
    name = "linker_fragments_config_soc_max78000_or_config_soc_max78002_deps",
    deps = [
        ":max7800x.ld.target",
    ],
)

zephyr_linker_fragment(
    name = "max7800x.ld.target",
    srcs = ["max7800x.ld"],
    location = "SECTIONS",
    sort_key = "default",
)
