load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "rtl8752h",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_FAMILY_REALTEK_BEE_IMAGE_HEADER=true": [
            "bee_image_header.c",
        ],
    }) + ["//soc/realtek/bee"] + ["//soc/realtek/bee/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/realtek/bee:bee_hdrs",
        "//soc/realtek/bee/common:common_hdrs",
    ],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":bee_image_header.ld.target",
    ],
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "bee_image_header.ld.target",
    srcs = ["bee_image_header.ld"],
    location = "ROM_START",
    sort_key = "0x0header",
)
