load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "common",
    srcs = [
    ] + select({
        ":config_hal_realtek_bee_tim_or_config_hal_realtek_bee_enhtim": [":common_config_hal_realtek_bee_tim_or_config_hal_realtek_bee_enhtim_deps"],
        "//conditions:default": [],
    }),
)

selects.config_setting_group(
    name = "config_hal_realtek_bee_tim_or_config_hal_realtek_bee_enhtim",
    match_any = [
        "@zephyr_kconfig//:CONFIG_HAL_REALTEK_BEE_TIM=true",
        "@zephyr_kconfig//:CONFIG_HAL_REALTEK_BEE_ENHTIM=true",
    ],
)

filegroup(
    name = "common_config_hal_realtek_bee_tim_or_config_hal_realtek_bee_enhtim_deps",
    srcs = [
        "bee_timer_common.c",
    ],
)

cc_library(
    name = "common_config_hal_realtek_bee_tim_or_config_hal_realtek_bee_enhtim_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

cc_library(
    name = "common_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)
