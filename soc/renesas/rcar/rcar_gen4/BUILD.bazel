load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "rcar_gen4",
    srcs = [
    ] + ["//soc/renesas/rcar"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/renesas/rcar:rcar_hdrs",
    ] + select({
        "@zephyr_kconfig//:CONFIG_SOC_R8A779F0_A55=true": [":rcar_gen4_config_soc_r8a779f0_a55_deps"],
        "//conditions:default": [],
    }),
)

zephyr_soc_library(
    name = "rcar_gen4_config_soc_r8a779f0_a55_deps",
    srcs = [
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_ARM_MMU=true": [
            "a55/mmu_regions.c",
        ],
    }),
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [],
)
