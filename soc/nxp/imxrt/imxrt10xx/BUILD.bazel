load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "imxrt10xx",
    srcs = [
        "soc.c",
    ] + ["//soc/nxp/imxrt"] + ["//soc/nxp/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/nxp/common:common_hdrs",
        "//soc/nxp/imxrt:imxrt_hdrs",
    ] + select({
        "@zephyr_kconfig//:CONFIG_PM=true": [":imxrt10xx_config_pm_deps"],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_MEMC_MCUX_FLEXSPI=true": [":imxrt10xx_config_memc_mcux_flexspi_deps"],
        "//conditions:default": [],
    }),
)

zephyr_soc_library(
    name = "imxrt10xx_config_pm_deps",
    srcs = [
        "power.c",
    ],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = select({
        "@zephyr_kconfig//:CONFIG_SOC_MIMXRT1064=true": [":imxrt10xx_config_pm_deps_config_soc_mimxrt1064_deps"],
        "//conditions:default": [],
    }),
)

zephyr_soc_library(
    name = "imxrt10xx_config_pm_deps_config_soc_mimxrt1064_deps",
    srcs = [
        "lpm_rt1064.c",
    ],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [],
)

zephyr_soc_library(
    name = "imxrt10xx_config_memc_mcux_flexspi_deps",
    srcs = [
        "flexspi.c",
    ],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [],
)
