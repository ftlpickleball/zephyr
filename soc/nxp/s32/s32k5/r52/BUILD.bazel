load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "r52",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_ARM_MPU=true": [
            "mpu_regions.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_RESET_HOOK=true": [
            "s32k5xx_startup.S",
        ],
    }) + ["//soc/nxp/s32/s32k5"] + ["//soc/nxp/s32/common"] + ["//soc/nxp/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/nxp/common:common_hdrs",
        "//soc/nxp/s32/common:common_hdrs",
        "//soc/nxp/s32/s32k5:s32k5_hdrs",
    ],
)
