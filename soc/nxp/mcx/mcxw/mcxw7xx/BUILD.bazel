load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "mcxw7xx",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_MCXW70AC=true": [
            "mcxw70_platform_init.S",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_MCXW716C=true": [
            "mcxw71_platform_init.S",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_MCXW727C=true": [
            "mcxw72_platform_init.S",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_PM=true": [
            "power.c",
        ],
    }) + ["//soc/nxp/mcx/mcxw"] + ["//soc/nxp/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/nxp/common:common_hdrs",
        "//soc/nxp/mcx/mcxw:mcxw_hdrs",
    ],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":boot_header.ld.target",
    ] + select({
        "@zephyr_kconfig//:CONFIG_NXP_NBU=true": [":linker_fragments_config_nxp_nbu_deps"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "boot_header.ld.target",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_NXP_MCXW7XX_BOOT_HEADER=true": ["boot_header.ld"],
        "//conditions:default": [],
    }),
    location = "ROM_START",
    sort_key = "0",
)

zephyr_linker_fragment(
    name = "linker_fragments_config_nxp_nbu_deps",
    deps = [
        ":sections.ld.target",
    ],
)

zephyr_linker_fragment(
    name = "sections.ld.target",
    srcs = ["sections.ld"],
    location = "RAM_SECTIONS",
    sort_key = "default",
)
