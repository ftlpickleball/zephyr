load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "mcxn",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_CPU_FREQ_PSTATE_SET_SOC=true": [
            "cpu_freq_scale.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_PM=true": [
            "power.c",
        ],
    }) + ["//soc/nxp/mcx"] + ["//soc/nxp/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/nxp/common:common_hdrs",
        "//soc/nxp/mcx:mcx_hdrs",
    ] + select({
        ":config_flash_mcux_flexspi_xip_or_config_flash_mcux_flexspi_nor": [":mcxn_config_flash_mcux_flexspi_xip_or_config_flash_mcux_flexspi_nor_deps"],
        "//conditions:default": [],
    }),
)

selects.config_setting_group(
    name = "config_flash_mcux_flexspi_xip_or_config_flash_mcux_flexspi_nor",
    match_any = [
        "@zephyr_kconfig//:CONFIG_FLASH_MCUX_FLEXSPI_XIP=true",
        "@zephyr_kconfig//:CONFIG_FLASH_MCUX_FLEXSPI_NOR=true",
    ],
)

zephyr_soc_library(
    name = "mcxn_config_flash_mcux_flexspi_xip_or_config_flash_mcux_flexspi_nor_deps",
    srcs = [
        "flash_clock_setup.c",
    ],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":boot_header.ld.target",
    ],
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "boot_header.ld.target",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_NXP_FLEXSPI_BOOT_HEADER=true": ["boot_header.ld"],
        "//conditions:default": [],
    }),
    location = "ROM_START",
    sort_key = "0",
)
