load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "imx8m",
    srcs = [
    ] + ["//soc/nxp/imx"] + select({
        "@zephyr_kconfig//:CONFIG_SOC_MIMX8ML8_ADSP=true": [":imx8m_config_soc_mimx8ml8_adsp_deps"],
        "//conditions:default": [],
    }) + select({
        ":config_soc_mimx8ml8_a53_or_config_soc_mimx8mm6_a53_or_config_soc_mimx8mn6_a53": [":imx8m_config_soc_mimx8ml8_a53_or_config_soc_mimx8mm6_a53_or_config_soc_mimx8mn6_a53_deps"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "imx8m_config_soc_mimx8ml8_adsp_deps",
    srcs = [
        "//soc/nxp/imx/imx8m/adsp:pinctrl_soc.h",
    ],
)

cc_library(
    name = "imx8m_config_soc_mimx8ml8_adsp_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

selects.config_setting_group(
    name = "config_soc_mimx8ml8_a53_or_config_soc_mimx8mm6_a53_or_config_soc_mimx8mn6_a53",
    match_any = [
        "@zephyr_kconfig//:CONFIG_SOC_MIMX8ML8_A53=true",
        "@zephyr_kconfig//:CONFIG_SOC_MIMX8MM6_A53=true",
        "@zephyr_kconfig//:CONFIG_SOC_MIMX8MN6_A53=true",
    ],
)

filegroup(
    name = "imx8m_config_soc_mimx8ml8_a53_or_config_soc_mimx8mm6_a53_or_config_soc_mimx8mn6_a53_deps",
    srcs = [
        "a53/pinctrl_soc.h",
        "a53/soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_ARM_MMU=true": [
            "a53/mmu_regions.c",
        ],
    }),
)

cc_library(
    name = "imx8m_config_soc_mimx8ml8_a53_or_config_soc_mimx8mm6_a53_or_config_soc_mimx8mn6_a53_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

cc_library(
    name = "imx8m_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = ["//soc/nxp/imx:imx_hdrs"],
)
