load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"], allow_empty = True),
    includes = ["."],
)

genrule(
    name = "prepend_asm_reboot",
    srcs = ["reboot.S"],
    outs = ["reboot.out.S"],
    cmd = """
        echo "#define _ASMLANGUAGE" > $@
        cat $< >> $@
    """,
)

zephyr_soc_library(
    name = "ti_lm3s6965",
    srcs = [
        ":prepend_asm_reboot",
        "soc_config.c",
        "sys_arch_reboot.c",
    ],
    hdrs = glob(["*.h"], allow_empty = True),
    includes = ["."],
    deps = [],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [],
)
