load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "common",
    srcs = [
        "power.c",
    ] + select({
        ":config_soc_series_bl60x_or_config_soc_series_bl70x_or_config_soc_series_bl70xl": [":common_config_soc_series_bl60x_or_config_soc_series_bl70x_or_config_soc_series_bl70xl_deps"],
        "//conditions:default": [],
    }),
)

selects.config_setting_group(
    name = "config_soc_series_bl60x_or_config_soc_series_bl70x_or_config_soc_series_bl70xl",
    match_any = [
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_BL60X=true",
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_BL70X=true",
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_BL70XL=true",
    ],
)

filegroup(
    name = "common_config_soc_series_bl60x_or_config_soc_series_bl70x_or_config_soc_series_bl70xl_deps",
    srcs = [
        "e24/soc.c",
        "e24/soc_irq_privileged.c",
    ],
)

cc_library(
    name = "common_config_soc_series_bl60x_or_config_soc_series_bl70x_or_config_soc_series_bl70xl_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

cc_library(
    name = "common_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)
