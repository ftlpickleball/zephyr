load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "common",
    srcs = [
    ] + select({
        "@zephyr_kconfig//:CONFIG_SOC_FAMILY_MICROCHIP_SAMA7=true": [":common_config_soc_family_microchip_sama7_deps"],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_ARM_CUSTOM_INTERRUPT_CONTROLLER=true": [":common_config_arm_custom_interrupt_controller_deps"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "common_config_soc_family_microchip_sama7_deps",
    srcs = [
        "clk-generated.c",
        "clk-main.c",
        "clk-master.c",
        "clk-peripheral.c",
        "clk-programmable.c",
        "clk-sam9x60-pll.c",
        "clk-system.c",
        "pmc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMA7G5=true": [
            "clk-utmi.c",
            "sama7g5.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SERIES_SAMA7D6=true": [
            "sama7d65.c",
        ],
    }),
)

cc_library(
    name = "common_config_soc_family_microchip_sama7_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

filegroup(
    name = "common_config_arm_custom_interrupt_controller_deps",
    srcs = [
        "irq_aic.c",
    ],
)

cc_library(
    name = "common_config_arm_custom_interrupt_controller_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

cc_library(
    name = "common_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)
