load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_soc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

zephyr_soc_library(
    name = "silabs_s2",
    srcs = [
        "soc.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_GECKO_USE_RAIL=true": [
            "soc_radio.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_SOC_SILABS_IMAGE_PROPERTIES=true": [
            "soc_image_properties.c",
        ],
    }) + ["//soc/silabs"] + ["//soc/silabs/common"] + ["//soc/common"],
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//soc/common:common_hdrs",
        "//soc/silabs:silabs_hdrs",
        "//soc/silabs/common:common_hdrs",
    ],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
        ":soc_image_properties.ld.target",
    ],
)

cc_library(
    name = "linker_includes",
    hdrs = glob(
        ["**/*.ld"],
        allow_empty = True,
    ),
)

zephyr_linker_fragment(
    name = "soc_image_properties.ld.target",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_SOC_SILABS_IMAGE_PROPERTIES=true": ["soc_image_properties.ld"],
        "//conditions:default": [],
    }),
    location = "RODATA",
    sort_key = "default",
)
