load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "uicr",
    srcs = [
    ] + ["//soc/nordic/common"] + select({
        "@zephyr_kconfig//:CONFIG_NRF_PERIPHCONF_GENERATE_ENTRIES=true": [":uicr_config_nrf_periphconf_generate_entries_deps"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "uicr_config_nrf_periphconf_generate_entries_deps",
    srcs = [
        "${periphconf_entries_c_file}",
    ],
)

cc_library(
    name = "uicr_config_nrf_periphconf_generate_entries_deps_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [],
)

cc_library(
    name = "uicr_hdrs",
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
    # This is unfortunate. Zephyr often uses #include <xxx.h> for headers in
    # the SoC directories, and expects the SoC directories to be on the system
    # include paths.
    includes = ["."],
    deps = [] + ["//soc/nordic/common:common_hdrs"],
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = [
    ] + select({
        "@zephyr_kconfig//:CONFIG_NRF_PERIPHCONF_SECTION=true": [":linker_fragments_config_nrf_periphconf_section_deps"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "linker_includes",
    hdrs = glob(["**/*.ld"], allow_empty=True),
)

zephyr_linker_fragment(
    name = "linker_fragments_config_nrf_periphconf_section_deps",
    deps = [
        ":uicr.ld.target",
    ],
)

zephyr_linker_fragment(
    name = "uicr.ld.target",
    srcs = ["uicr.ld"],
    location = "SECTIONS",
    sort_key = "default",
)
