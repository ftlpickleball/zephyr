# C standard config settings for toolchains (with override support)

string_flag(
    name = "c_standard",
    build_setting_default = "kconfig",
    values = [
        "kconfig",
        "90",
        "99",
        "11",
        "17",
        "23",
    ],
)

config_setting(
    name = "c_std_kconfig",
    flag_values = {":c_standard": "kconfig"},
)

config_setting(
    name = "c_std_90",
    flag_values = {":c_standard": "90"},
)

config_setting(
    name = "c_std_99",
    flag_values = {":c_standard": "99"},
)

config_setting(
    name = "c_std_11",
    flag_values = {":c_standard": "11"},
)

config_setting(
    name = "c_std_17",
    flag_values = {":c_standard": "17"},
)

config_setting(
    name = "c_std_23",
    flag_values = {":c_standard": "23"},
)

# AND groups (kconfig mode AND specific standard)
selects.config_setting_group(
    name = "c_std_kconfig_and_c90",
    match_all = [
        ":c_std_kconfig",
        "@zephyr_kconfig//:CONFIG_STD_C90=true",
    ],
)

selects.config_setting_group(
    name = "c_std_kconfig_and_c99",
    match_all = [
        ":c_std_kconfig",
        "@zephyr_kconfig//:CONFIG_STD_C99=true",
    ],
)

selects.config_setting_group(
    name = "c_std_kconfig_and_c11",
    match_all = [
        ":c_std_kconfig",
        "@zephyr_kconfig//:CONFIG_STD_C11=true",
    ],
)

selects.config_setting_group(
    name = "c_std_kconfig_and_c17",
    match_all = [
        ":c_std_kconfig",
        "@zephyr_kconfig//:CONFIG_STD_C17=true",
    ],
)

selects.config_setting_group(
    name = "c_std_kconfig_and_c23",
    match_all = [
        ":c_std_kconfig",
        "@zephyr_kconfig//:CONFIG_STD_C23=true",
    ],
)

# Final Triggers (explicit OR (kconfig AND kconfig_option))
selects.config_setting_group(
    name = "c90_enabled",
    match_any = [
        ":c_std_90",
        ":c_std_kconfig_and_c90",
    ],
)

selects.config_setting_group(
    name = "c99_enabled",
    match_any = [
        ":c_std_99",
        ":c_std_kconfig_and_c99",
    ],
)

selects.config_setting_group(
    name = "c11_enabled",
    match_any = [
        ":c_std_11",
        ":c_std_kconfig_and_c11",
    ],
)

selects.config_setting_group(
    name = "c17_enabled",
    match_any = [
        ":c_std_17",
        ":c_std_kconfig_and_c17",
    ],
)

selects.config_setting_group(
    name = "c23_enabled",
    match_any = [
        ":c_std_23",
        ":c_std_kconfig_and_c23",
    ],
)

config_setting(
    name = "gnu_extensions_enabled",
    flag_values = {"@zephyr_kconfig//:CONFIG_GNU_C_EXTENSIONS": "true"},
)

config_setting(
    name = "gnu_extensions_disabled",
    flag_values = {"@zephyr_kconfig//:CONFIG_GNU_C_EXTENSIONS": "false"},
)

# Redefined C standard config settings for toolchains
selects.config_setting_group(
    name = "std_c90_gnu",
    match_all = [
        ":c90_enabled",
        ":gnu_extensions_enabled",
