_ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT = get_repo_root("@zephyr_sdk_arm")

cc_args(
    name = "sysroot",
    actions = [
        "@rules_cc//cc/toolchains/actions:assembly_actions",
        "@rules_cc//cc/toolchains/actions:compile_actions",
        "@rules_cc//cc/toolchains/actions:link_actions",
    ],
    args = [
        "--sysroot=" + _ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT + "/arm-zephyr-eabi",
    ],
)

# In some cases, Zephyr adds "-nostdinc" flag to the compiler flags, and that
# will mask compiler includes like stddef.h. Zephyr adds them back using
# -isystem. We do it here.
cc_args(
    name = "add_stddef",
    actions = [
        "@rules_cc//cc/toolchains/actions:c_compile_actions",
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
    ],
    args = [
        "-isystem",
        _ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT + "/lib/gcc/arm-zephyr-eabi/14.3.0/include",
        "-isystem",
        _ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT + "/lib/gcc/arm-zephyr-eabi/14.3.0/include-fixed",
    ],
)

cc_args(
    name = "add_cxx_headers",
    actions = [
        "@rules_cc//cc/toolchains/actions:cpp_compile_actions",
    ],
    args = [
        "-isystem",
        _ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT + "/arm-zephyr-eabi/include/c++/14.3.0",
        "-isystem",
        _ZEPHYR_SDK_ARM_TOOLCHAIN_ROOT + "/arm-zephyr-eabi/include/c++/14.3.0/arm-zephyr-eabi",
    ],
)

cc_toolchain(
    name = "cortex-m_gcc",
    args = [
        "//toolchain/args:zephyr_gcc_optimization_flags",
        "//toolchain/args:debugging",
        "//toolchain/args:reduced_size",
        "//toolchain/args:no_canonical_prefixes",
        "//toolchain/args:common_warnings",
        "//toolchain/args:color_diagnostics",
        "//toolchain/args:zephyr_common",
    ] + select({
        "//constraints/arm:cortex-m0": [":gcc_cortex-m0"],
        "//constraints/arm:cortex-m0plus": [":gcc_cortex-m0plus"],
        "//constraints/arm:cortex-m1": [":gcc_cortex-m1"],
        "//constraints/arm:cortex-m3": [":gcc_cortex-m3"],
        "//constraints/arm:cortex-m4": [":gcc_cortex-m4"],
        "//constraints/arm:cortex-m7": [":gcc_cortex-m7"],
        "//constraints/arm:cortex-m23": [":gcc_cortex-m23"],
        "//constraints/arm:cortex-m33": [":gcc_cortex-m33"],
        "//constraints/arm:cortex-m52": [":gcc_cortex-m52"],
        "//constraints/arm:cortex-m55": [":gcc_cortex-m55"],
        "//constraints/arm:cortex-m85": [":gcc_cortex-m85"],
        "//constraints/arm:none": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_FP_HARDABI=true": [":float_abi_hard"],
        "@zephyr_kconfig//:CONFIG_FP_SOFTABI=true": [":float_abi_softfp"],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_FP16_IEEE=true": [":fp16_format_ieee"],
        "@zephyr_kconfig//:CONFIG_FP16_ALT=true": [":fp16_format_alt"],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_THREAD_LOCAL_STORAGE=true": [":thread_local_storage_soft"],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_ARM_SECURE_FIRMWARE=true": [":secure_firmware"],
        "//conditions:default": [],
    }) + [
        ":thumb_abi",
        ":cortex_common",
        ":no_canonical_system_headers",
        ":warnings",
        ":add_stddef",
        ":add_cxx_headers",
        ":sysroot",
        "//toolchain/args:zephyr_mode_defines",
        "//toolchain/args:gcc_cxx_flags",
        "//toolchain/args:extra_toolchain_args",
    ],
    enabled_features = [
        "@rules_cc//cc/toolchains/args:experimental_replace_legacy_action_config_features",
        "//toolchain/capability:compiler_is_gcc",
        "//toolchain/capability:linker_is_gcc",
        "//toolchain/args:zephyr_force_include_autoconf",
        "//toolchain/args:zephyr_stdint",
        "//toolchain/args:nostdinc",
        "//toolchain/args:zephyr_gcc_link_flags",
        # This MUST be the last feature!!!!
        ":cortex_libc",
    ] + select({
        "@zephyr_kconfig//:CONFIG_MINIMAL_LIBC=true": [
            "//toolchain/args:zephyr_minimal_libc",
        ],
        "//conditions:default": [],
    }) + select({
        "//lib/libc/picolibc:use_toolchain_picolibc": [
            "//toolchain/args:use_toolchain_picolibc",
        ],
        "//conditions:default": [],
    }) + select({
        "@zephyr_kconfig//:CONFIG_NEWLIB_LIBC=true": [
            "//toolchain/args:zephyr_newlib_libc",
        ],
        "//conditions:default": [],
    }) + select({
        "//toolchain/args/cc:c++98_enabled": ["//toolchain/args/cc:c++98"],
        "//toolchain/args/cc:c++11_enabled": ["//toolchain/args/cc:c++11"],
        "//toolchain/args/cc:c++14_enabled": ["//toolchain/args/cc:c++14"],
        "//toolchain/args/cc:c++17_enabled": ["//toolchain/args/cc:c++17"],
        "//toolchain/args/cc:c++20_enabled": ["//toolchain/args/cc:c++20"],
        "//toolchain/args/cc:c++23_enabled": ["//toolchain/args/cc:c++23"],
        "//conditions:default": [],
    }) + select({
        "//toolchain/args/c:std_c90_gnu": ["//toolchain/args/c:gnu90"],
        "//toolchain/args/c:std_c90_pure": ["//toolchain/args/c:c90"],
        "//toolchain/args/c:std_c99_gnu": ["//toolchain/args/c:gnu99"],
        "//toolchain/args/c:std_c99_pure": ["//toolchain/args/c:c99"],
        "//toolchain/args/c:std_c11_gnu": ["//toolchain/args/c:gnu11"],
        "//toolchain/args/c:std_c11_pure": ["//toolchain/args/c:c11"],
        "//toolchain/args/c:std_c17_gnu": ["//toolchain/args/c:gnu17"],
        "//toolchain/args/c:std_c17_pure": ["//toolchain/args/c:c17"],
        "//toolchain/args/c:std_c23_gnu": ["//toolchain/args/c:gnu23"],
        "//toolchain/args/c:std_c23_pure": ["//toolchain/args/c:c23"],
        "//conditions:default": [],
    }),
    known_features = [
        "//toolchain/capability:known_toolchain_types",
        "//toolchain/args:zephyr_warning_suppressions",
        "//toolchain/args:freestanding",
        "//toolchain/args/cc:c++98",
        "//toolchain/args/cc:c++11",
        "//toolchain/args/cc:c++14",
        "//toolchain/args/cc:c++17",
        "//toolchain/args/cc:c++20",
        "//toolchain/args/cc:c++23",
        "//toolchain/args/c:c90",
        "//toolchain/args/c:gnu90",
        "//toolchain/args/c:c99",
        "//toolchain/args/c:gnu99",
        "//toolchain/args/c:c11",
        "//toolchain/args/c:gnu11",
        "//toolchain/args/c:c17",
        "//toolchain/args/c:gnu17",
        "//toolchain/args/c:c23",
        "//toolchain/args/c:gnu23",
    ],
    supports_param_files = 0,
    tags = ["manual"],
    tool_map = "@zephyr_sdk_arm//:arm_tools",
)
_ZEPHYR_SDK_LLVM_TOOLCHAIN_ROOT = get_repo_root("@zephyr_sdk_llvm")


