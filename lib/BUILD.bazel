load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "lib",
    deps = [
        "//lib/heap",
        "//lib/libc",
        "//lib/mem_blocks",
        "//lib/os",
        "//lib/utils",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_CPP=true": [
            "//lib/cpp",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_NET_BUF=true": [
            "//lib/net_buf",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_UUID=true": [
            "//lib/uuid",
        ],
    }) + select({
        "@zephyr_kconfig//:CONFIG_NATIVE_LIBC=true": [],
        "//conditions:default": [":deps_not_native_libc"],
    }),
)

cc_library(
    name = "deps_not_native_libc",
    deps = select({
        "@zephyr_kconfig//:CONFIG_POSIX_C_LIB_EXT=true": [
            "//lib/posix/c_lib_ext",
        ],
        "//conditions:default": [],
    }),
)
