load("//bazel:cc.bzl", "zephyr_freestanding_library")

package(default_visibility = ["//visibility:public"])

zephyr_freestanding_library(
    name = "xclib",
    srcs = [
        "libc-hooks.c",
        "multithreading.c",
    ],
    linkopts = [
        "-Wl,--start-group",
        "-lm",
        "-lc",
        "-lgcc",
        "-lsim",
        "-lhal",
        "-lc++-re",
        "-lc++abi-re",
        "-Wl,--end-group",
    ],
)
