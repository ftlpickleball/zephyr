load("@bazel_skylib//lib:selects.bzl", "selects")
load("//bazel:cc.bzl", "zephyr_cc_library")
load("//bazel:cc_test.bzl", "ztest")

package(default_visibility = ["//visibility:public"])

zephyr_cc_library(
    name = "main",
    srcs = [
        "src/atomic.c",
        "src/bitarray.c",
        "src/boot_delay.c",
        "src/byteorder.c",
        "src/clock.c",
        "src/errno.c",
        "src/main.c",
        "src/multilib.c",
        "src/pow2.c",
        "src/timeout_order.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_PRINTK=true": [
            "src/printk.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_IRQ_OFFLOAD=true": [
            "src/irq_offload.c",
        ],
    }),
    hdrs = glob(["**/*.h"], allow_empty = True),
    deps = [
        "@zephyr_version//:version",
    ],
)

ztest(
    name = "common",
    deps = [":main"],
)
