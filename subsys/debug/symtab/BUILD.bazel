load("//bazel:cc.bzl", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

zephyr_cc_library(
    name = "symtab",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_SYMTAB=true": [
            "symtab.c",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
)

zephyr_cc_library(
    name = "symtab_stub",
    srcs = select({
        "@zephyr_kconfig//:CONFIG_SYMTAB=true": [
            "symtab_stub.c",
        ],
        "//conditions:default": [],
    }),
)
