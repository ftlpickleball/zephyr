module(
    name = "zephyr",
    version = "3.5.99",
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_rust", version = "0.70.0")
bazel_dep(name = "pigweed")

git_override(
    module_name = "pigweed",
    # ROLL: Warning: this is automatically updated by
    # ROLL: https://cr-buildbucket.appspot.com/build/8664771569579646625
    commit = "fe91596ff0ba52e43cbd390832302420a095f09f",
    remote = "https://pigweed.googlesource.com/pigweed/pigweed",
)

pw_cxx_toolchain = use_extension("@pigweed//pw_toolchain/cc:pw_cxx_toolchain.bzl", "pw_cxx_toolchain")
use_repo(pw_cxx_toolchain, "llvm_toolchain")

bazel_supports_repo = use_repo_rule("//bazel:bazel_supports.bzl", "bazel_supports_repo")
bazel_supports_repo(name = "bazel_supports")

# Directory-tree trackers for dependency tracking (see bazel/docs/dependency_tracking.md).
# Downstream modules do not declare these: deps.bzl refers to them through @zephyr's own repo
# mapping (Label("@skyframe_warmer//...")), and zephyr_workspace_manifest reads the root module's
# zephyr_setup.env() tags itself.
skyframe_warmer = use_repo_rule("//bazel/private:deps.bzl", "skyframe_warmer")

skyframe_warmer(name = "skyframe_warmer")

zephyr_workspace_manifest = use_repo_rule("//bazel/private:deps.bzl", "zephyr_workspace_manifest")

zephyr_workspace_manifest(name = "zephyr_workspace_manifest")

# Register Zephyr C++ toolchains.
register_toolchains(
    "//toolchain:all",
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_linux",
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_macos",
    dev_dependency = True,
)

cipd = use_extension("@pigweed//pw_env_setup/bazel/cipd:defs.bzl", "cipd")

cipd.require(
    name = "gperf",
    build_file = "@zephyr//bazel/tools/gperf:gperf.BUILD",
    packages = {
        "infra/3pp/tools/gperf/${os=linux}-${arch}": "version:3@3.2.chromium.1",
    },
)

cipd.require(
    name = "gperf_src",
    build_file = "@zephyr//bazel/tools/gperf:gperf_src.BUILD",
    packages = {
