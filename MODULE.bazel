use_repo(pw_cxx_toolchain, "llvm_toolchain")

bazel_supports_repo = use_repo_rule("//bazel:bazel_supports.bzl", "bazel_supports_repo")
bazel_supports_repo(name = "bazel_supports")

# Register Zephyr C++ toolchains.
register_toolchains(
    "//toolchain:all",
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_linux",
    "@pigweed//pw_toolchain/host_clang:host_cc_toolchain_macos",
    dev_dependency = True,
)

