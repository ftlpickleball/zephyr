    python_version = "3.12",
)
python.toolchain(
    python_version = "3.13",
)
python.toolchain(
    python_version = "3.14",
)
use_repo(python, "pythons_hub")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    experimental_index_url = "https://pypi.org/simple",
    extra_pip_args = [
        "--no-index",
        "--no-build-isolation",
    ],
    hub_name = "zephyr_pip_deps",
    python_version = "3.11",
    requirements_lock = "//bazel/pip:requirements-lock.txt",
)
pip.parse(
    experimental_index_url = "https://pypi.org/simple",
    extra_pip_args = [
        "--no-index",
        "--no-build-isolation",
    ],
    hub_name = "zephyr_pip_deps",
    python_version = "3.12",
    requirements_lock = "//bazel/pip:requirements-lock.txt",
)
