zephyr_setup = use_extension("//bazel:setup.bzl", "zephyr_setup")
zephyr_setup.env(
    apps_dirs = [
        "//samples",
        "//tests",
        "@mcuboot//:boot/zephyr",
    ],
    boards_dirs = ["//boards"],
    manual_boards = [
        "max32655evkit/max32655/m4",
        "max32655evkit/max32655/rv32",
        "max32690evkit/max32690/m4",
        "max32690evkit/max32690/rv32",
        "max78002evkit/max78002/m4",
        "max78002evkit/max78002/rv32",
        "native_sim/native",
        "native_sim/native/64",
        "nrf52833dk/nrf52820",
        "nrf52833dk/nrf52833",
        "nrf52840dk/nrf52811",
        "nrf52840dk/nrf52840",
        "nrf5340dk/nrf5340/cpuapp",
        "nrf5340dk/nrf5340/cpunet",
        "qemu_cortex_m3",
        "qemu_malta",
    ],
    modules = [
        "@hal_adi//:zephyr/module.yml",
        "@hal_nordic//:zephyr/module.yml",
        "@mcuboot//:zephyr/module.yml",
    ],
)
use_repo(
    zephyr_setup,
    "zephyr_index",
    "zephyr_kconfig",
    "zephyr_state",
    "zephyr_version",
)

zephyr_setup_apps = use_extension("//bazel:setup.bzl", "zephyr_setup_apps")
