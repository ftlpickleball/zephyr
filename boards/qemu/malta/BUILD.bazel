load("//bazel:defs.bzl", "dts_cc_library", "dts_library")
load("//bazel:flags.bzl", "flags_from_dict")

package(default_visibility = ["//visibility:public"])

dts_library(
    name = "devicetree_lib",
    includes = [
        "//dts:dts_includes",
        "//include:include_includes",
    ],
    overlay = "qemu_malta.dts",
    references = [
        "//dts/common",
        "//include:dt_bindings",
    ],
)

dts_cc_library(
    name = "devicetree_generated",
    bindings = ["//dts:bindings"],
    dts_lib = ":devicetree_lib",
)

platform(
    name = "qemu_malta",
    constraint_values = [
        "@zephyr//constraints:mips",
    ],
    flags = flags_from_dict({
        "@zephyr//:board_deps": "@rules_cc//:empty_lib",
        "@zephyr//:dt_binding_headers_library": "@rules_cc//:empty_lib",
        "@zephyr//:dts_cc_library": "@zephyr//boards/mips/qemu_malta:devicetree_generated",
        "@zephyr//:extra_linker_includes": "@rules_cc//:empty_lib",
        "@zephyr//:hal_soc_headers_library": "@rules_cc//:empty_lib",
        "@zephyr//:soc": "@zephyr//soc/mips/qemu_malta:malta",
        "@zephyr//:soc_linkerscript_template": "@zephyr//include/zephyr/arch/mips:linker.ld",
        "@zephyr//:offsets_lib": "@zephyr//arch/mips:offsets",
        "@zephyr//:offsets_src": "@zephyr//arch/mips:offsets_src",
    }),
    parents = ["@zephyr//platforms:mips"],
)

platform(
    name = "qemu_malta_be",
    constraint_values = [
        "@zephyr//constraints:mips",
    ],
    flags = flags_from_dict({
        "@zephyr//:board_deps": "@rules_cc//:empty_lib",
        "@zephyr//:dt_binding_headers_library": "@rules_cc//:empty_lib",
        "@zephyr//:dts_cc_library": "@zephyr//boards/mips/qemu_malta:devicetree_generated",
        "@zephyr//:extra_linker_includes": "@rules_cc//:empty_lib",
        "@zephyr//:hal_soc_headers_library": "@rules_cc//:empty_lib",
        "@zephyr//:soc": "@zephyr//soc/mips/qemu_malta:malta",
        "@zephyr//:soc_linkerscript_template": "@zephyr//include/zephyr/arch/mips:linker.ld",
        "@zephyr//:offsets_lib": "@zephyr//arch/mips:offsets",
        "@zephyr//:offsets_src": "@zephyr//arch/mips:offsets_src",
    }),
    parents = ["@zephyr//platforms:mips"],
)
