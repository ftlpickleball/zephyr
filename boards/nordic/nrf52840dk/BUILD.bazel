load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel:defs.bzl", "dts_cc_library", "dts_library")
load("//bazel:flags.bzl", "flags_from_dict")
load("//bazel:runner.bzl", "zephyr_runner_config")

package(default_visibility = ["//visibility:public"])

dts_library(
    name = "devicetree_lib_nrf52840",
    includes = [
        "//dts:dts_includes",
        "//include:include_includes",
    ],
    overlay = "nrf52840dk_nrf52840.dts",
    references = [
        "nrf52840dk_nrf52840-pinctrl.dtsi",
        "//dts/arm/nordic",
        "//dts/common",
        "//dts/vendor",
        "//include:dt_bindings",
    ],
)

dts_cc_library(
    name = "devicetree_generated_nrf52840",
    bindings = ["//dts:bindings"],
    dts_lib = ":devicetree_lib_nrf52840",
    target_compatible_with = [":nordic_nrf52840dk"],
)

dts_library(
    name = "devicetree_lib_nrf52811",
    includes = [
        "//dts:dts_includes",
        "//include:include_includes",
    ],
    overlay = "nrf52840dk_nrf52811.dts",
    references = [
        "nrf52840dk_nrf52811-pinctrl.dtsi",
        "//dts/arm/nordic",
        "//dts/common",
        "//dts/vendor",
        "//include:dt_bindings",
    ],
)

dts_cc_library(
    name = "devicetree_generated_nrf52811",
    bindings = ["//dts:bindings"],
    dts_lib = ":devicetree_lib_nrf52811",
    target_compatible_with = [":nordic_nrf52840dk"],
)

alias(
    name = "devicetree_generated",
    actual = ":devicetree_generated_nrf52840",
)

constraint_value(
    name = "nordic_nrf52840dk",
    constraint_setting = "//boards:board_name",
)

cc_library(
    name = "hal_soc_headers_library",
    deps = [
        "@hal_nordic//:dt_interface",
        "//modules/hal_nordic/nrfx:nrfx_hdrs",
    ],
)

zephyr_runner_config(
    name = "nrf52840_runner",
    args = [
        "--device=nRF52840_xxAA",
        "--speed=4000",
    ],
    runner = "jlink",
)

zephyr_runner_config(
    name = "nrf52811_runner",
    args = [
        "--device=nRF52811_xxAA",
        "--speed=4000",
    ],
    runner = "jlink",
)

platform(
    name = "nrf52840",
    constraint_values = [
        ":nordic_nrf52840dk",
        "@platforms//cpu:armv7e-m",
        "//constraints/arm:cortex-m4",
        "//boards:hw",
    ],
    flags = flags_from_dict({
        "@zephyr//:board_runner_config": "@zephyr//boards/nordic/nrf52840dk:nrf52840_runner",
        "@zephyr//:dts_cc_library": "@zephyr//boards/nordic/nrf52840dk:devicetree_generated_nrf52840",
        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/nordic/nrf52840dk:hal_soc_headers_library",
        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
    }),
    parents = ["//platforms:cortex_m"],
)

platform(
    name = "nrf52811",
    constraint_values = [
        ":nordic_nrf52840dk",
        "@platforms//cpu:armv7e-m",
        "//constraints/arm:cortex-m4",
        "//boards:hw",
    ],
    flags = flags_from_dict({
        "@zephyr//:board_runner_config": "@zephyr//boards/nordic/nrf52840dk:nrf52811_runner",
        "@zephyr//:dts_cc_library": "@zephyr//boards/nordic/nrf52840dk:devicetree_generated_nrf52811",
        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/nordic/nrf52840dk:hal_soc_headers_library",
        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
    }),
    parents = ["//platforms:cortex_m"],
)

alias(
    name = "nrf52840dk",
    actual = ":nrf52840",
)
