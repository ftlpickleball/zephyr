load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sdl2_headers",
    hdrs = glob(["include/*.h"]),
    strip_include_prefix = "include",
    target_compatible_with = [
        "@platforms//os:linux",
        "@zephyr//boards:sim",
    ],
)

cc_library(
    name = "sdl2",
    srcs = [
        "src/core/linux/SDL_threadprio.c",
    ] + glob([
        "src/*.c",
        "src/atomic/*.c",
        "src/audio/*.c",
        "src/audio/dummy/*.c",
        "src/core/unix/*.c",
        "src/cpuinfo/*.c",
        "src/dynapi/*.c",
        "src/events/*.c",
        "src/file/*.c",
        "src/filesystem/dummy/*.c",
        "src/haptic/*.c",
        "src/haptic/dummy/*.c",
        "src/hidapi/*.c",
        "src/joystick/*.c",
        "src/joystick/dummy/*.c",
        "src/libm/*.c",
        "src/loadso/dlopen/*.c",
        "src/locale/*.c",
        "src/locale/dummy/*.c",
        "src/misc/*.c",
        "src/misc/dummy/*.c",
        "src/power/*.c",
        "src/render/*.c",
        "src/render/opengl/*.c",
        "src/render/software/*.c",
        "src/sensor/*.c",
        "src/sensor/dummy/*.c",
        "src/stdlib/*.c",
        "src/thread/*.c",
        "src/thread/pthread/*.c",
        "src/timer/*.c",
        "src/timer/unix/*.c",
        "src/video/*.c",
        "src/video/dummy/*.c",
        "src/video/offscreen/*.c",
        "src/video/x11/*.c",
        "src/video/yuv2rgb/*.c",
    ]),
    hdrs = glob(["src/**/*.h"]),
    copts = [
        "-U__ZEPHYR__",
        "-UKERNEL",
        "-w",
    ],
    features = [
        "-zephyr_force_include_autoconf",
        "-zephyr_app_main",
        "-zephyr_errno",
        "-zephyr_stdint",
    ],
    includes = ["src"],
    linkopts = [
        "-ldl",
        "-lpthread",
        "-lm",
    ],
    local_defines = [
        "_GNU_SOURCE",
        "SDL_config_minimal_h_=1",
        "SDL_AUDIO_DRIVER_DUMMY=1",
        "SDL_FILESYSTEM_DUMMY=1",
        "SDL_HAPTIC_DISABLED=1",
        "SDL_HIDAPI_DISABLED=1",
        "SDL_JOYSTICK_DISABLED=1",
        "SDL_LOADSO_DLOPEN=1",
        "SDL_SENSOR_DISABLED=1",
        "SDL_THREAD_PTHREAD=1",
        "SDL_THREAD_PTHREAD_RECURSIVE_MUTEX=1",
        "SDL_TIMER_UNIX=1",
        "SDL_VIDEO_DRIVER_DUMMY=1",
        "SDL_VIDEO_DRIVER_OFFSCREEN=1",
        "SDL_VIDEO_DRIVER_X11=1",
        "SDL_VIDEO_DRIVER_X11_DYNAMIC=\\\"libX11.so.6\\\"",
        "SDL_VIDEO_DRIVER_X11_DYNAMIC_XEXT=\\\"libXext.so.6\\\"",
        "SDL_VIDEO_DRIVER_X11_HAS_XKBKEYCODETOKEYSYM=1",
        "SDL_VIDEO_DRIVER_X11_SUPPORTS_GENERIC_EVENTS=1",
        "SDL_VIDEO_OPENGL=1",
        "SDL_VIDEO_OPENGL_GLX=1",
        "SDL_VIDEO_RENDER_OGL=1",
        "HAVE_GCC_SYNC_LOCK_TEST_AND_SET=1",
        "HAVE_LIBC=1",
        "HAVE_STDARG_H=1",
        "HAVE_STDDEF_H=1",
        "HAVE_STDINT_H=1",
        "HAVE_STDIO_H=1",
        "HAVE_STDLIB_H=1",
        "HAVE_STRING_H=1",
        "HAVE_INTTYPES_H=1",
        "HAVE_MATH_H=1",
        "HAVE_CLOCK_GETTIME=1",
        "HAVE_DLOPEN=1",
        "HAVE_GETENV=1",
        "HAVE_SETENV=1",
        "HAVE_PUTENV=1",
        "HAVE_UNSETENV=1",
        "HAVE_MALLOC=1",
        "HAVE_MEMSET=1",
        "HAVE_MEMCPY=1",
        "HAVE_MEMMOVE=1",
        "HAVE_MEMCMP=1",
        "HAVE_NANOSLEEP=1",
        "HAVE_O_CLOEXEC=1",
        "HAVE_POLL=1",
        "HAVE_SEM_TIMEDWAIT=1",
        "HAVE_STRLEN=1",
        "HAVE_STRCHR=1",
        "HAVE_STRRCHR=1",
        "HAVE_STRSTR=1",
        "HAVE_STRTOL=1",
        "HAVE_STRTOUL=1",
        "HAVE_STRTOLL=1",
        "HAVE_STRTOULL=1",
        "HAVE_STRTOD=1",
        "HAVE_ATOI=1",
        "HAVE_ATOF=1",
        "HAVE_STRCMP=1",
        "HAVE_STRNCMP=1",
        "HAVE_STRCASECMP=1",
        "HAVE_STRNCASECMP=1",
        "HAVE_VSSCANF=1",
        "HAVE_VSNPRINTF=1",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@zephyr//boards:sim",
    ],
    deps = [":sdl2_headers"],
)
