load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_cc_library")
load("//bazel:linker_fragment.bzl", "zephyr_linker_fragment")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "syscall_client_files",
    srcs = ["//include/zephyr/arch/riscv:syscall_client_files"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "offsets_src",
    srcs = ["core/offsets/offsets.c"],
)

cc_library(
    name = "offsets",
    srcs = [
        "core/offsets/offsets.c",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True) + ["//include/zephyr/arch/riscv:riscv_hdrs"],
    includes = [
        "core/offsets",
        "include",
    ],
    deps = [
        "//:autoconf_library",
        "//:dts_cc_library",
        "//:heap_constants_lib",
        "//:kobj_types_enum_h",
        "//:syscall_list",
        "//include:zephyr",
        "//kernel:headers",
    ],
)

zephyr_cc_library(
    name = "core",
    srcs = [
        "core/asm_macros.inc",
        "core/cpu_idle.c",
        "core/fatal.c",
        "core/irq_manage.c",
        "core/isr.S",
        "core/prep_c.c",
        "core/reset.S",
        "core/stacktrace.c",
        "core/switch.S",
        "core/thread.c",
        "//:kobj_types_enum_h",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_THREAD_LOCAL_STORAGE=true": ["core/tls.c"],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_RISCV_PMP=true": [
            "core/pmp.S",
            "core/pmp.c",
        ],
    }),
    includes = ["include"],
    deps = [
        "//:autoconf_library",
        "//:syscall_list",
        "//include:zephyr",
        "//kernel",
    ],
)

# We ignore kconfig conditions for linker includes, because linker includes
# are similar to headers in that they need to exist when some other file
# includes them, but there's no harm if they are present but not used (unless
# there is a naming collision). If this turns out to be a problem, we should
# add kconfig conditions on these.
cc_library(
    name = "linker_includes",
    hdrs = glob(["**/*.ld"], allow_empty = True),
)

zephyr_linker_fragment(
    name = "pmp",
    srcs = ["core/pmp.ld"],
    location = "ROM_SECTIONS",
)

zephyr_linker_fragment(
    name = "linker_fragments",
    deps = select({
        "@zephyr_kconfig//:CONFIG_RISCV_PMP=true": [":pmp"],
        "//conditions:default": [],
    }),
)
