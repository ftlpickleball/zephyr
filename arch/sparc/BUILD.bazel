load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "offsets_src",
    srcs = ["core/offsets/offsets.c"],
)

cc_library(
    name = "offsets",
    srcs = [
        "core/offsets/offsets.c",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True) + ["//include/zephyr/arch/sparc:sparc_hdrs"],
    includes = [
        "core/offsets",
        "include",
    ],
    deps = [
        "//:autoconf_library",
        "//:dts_cc_library",
        "//:kobj_types_enum_h",
        "//:soc",
        "//:syscall_list",
        "//include:zephyr",
        "//kernel:headers",
    ],
)

zephyr_cc_library(
    name = "core",
    srcs = [
        "core/fatal.c",
        "core/fault_trap.S",
        "core/interrupt_trap.S",
        "core/irq_manage.c",
        "core/prep_c.c",
        "core/reset_trap.S",
        "core/stack_offsets.h",
        "core/sw_trap_set_pil.S",
        "core/switch.S",
        "core/thread.c",
        "core/window_trap.S",
        "//:kobj_types_enum_h",
    ] + select({
        "@zephyr_kconfig//:CONFIG_SPARC_SVT=true": ["core/trap_table_svt.S"],
        "//conditions:default": ["core/trap_table_mvt.S"],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_THREAD_LOCAL_STORAGE=true": ["core/tls.c"],
    }),
    includes = ["include"],
    deps = [
        "//:autoconf_library",
        "//:syscall_list",
        "//include:zephyr",
        "//kernel",
    ],
)
