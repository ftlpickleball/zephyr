load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:cc.bzl", "zephyr_cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "offsets_src",
    srcs = ["core/offsets/offsets.c"],
)

cc_library(
    name = "offsets",
    srcs = [
        "core/offsets/offsets.c",
    ],
    hdrs = glob(["include/**/*.h"], allow_empty = True),
    includes = [
        "core/offsets",
        "include",
    ],
    deps = [
        "//:autoconf_library",
        "//:dts_cc_library",
        "//:heap_constants_lib",
        "//:kobj_types_enum_h",
        "//:syscall_list",
        "//include:zephyr",
        "//kernel:headers",
    ],
)

zephyr_cc_library(
    name = "core_asm",
    srcs = [
        "core/boot.h",
        "core/early_mem_funcs.S",
        "core/fpu.S",
        "core/header.S",
        "core/isr_wrapper.S",
        "core/macro_priv.inc",
        "core/mmu.S",
        "core/mmu.h",
        "core/reset.S",
        "core/smccc-call.S",
        "core/switch.S",
        "core/userspace.S",
        "core/vector_table.S",
    ],
    local_defines = [
        "_ASMLANGUAGE",
    ],
)

zephyr_cc_library(
    name = "core",
    srcs = [
        "core/boot.h",
        "core/cpu_idle.c",
        "core/fatal.c",
        "core/fpu.c",
        "core/irq_init.c",
        "core/irq_manage.c",
        "core/mmu.c",
        "core/paging.h",
        "core/prep_c.c",
        "core/reboot.c",
        "core/reset.c",
        "core/semihost.c",
        "core/smp.c",
        "core/thread.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_LLEXT=true": ["core/elf.c"],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_THREAD_LOCAL_STORAGE=true": ["core/tls.c"],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_IRQ_OFFLOAD=true": ["core/irq_offload.c"],
    }),
    deps = [
        ":core_asm",
        "//:syscall_list",
        "//kernel",
    ],
)
