load("//bazel:cc.bzl", "zephyr_cc_library")

package(default_visibility = ["//:__subpackages__"])

zephyr_cc_library(
    name = "lsm6dsl",
    srcs = [
        "lsm6dsl.c",
        "lsm6dsl_i2c.c",
        "lsm6dsl_spi.c",
    ] + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_LSM6DSL_TRIGGER=true": [
            "lsm6dsl_trigger.c",
        ],
    }) + select({
        "//conditions:default": [],
        "@zephyr_kconfig//:CONFIG_LSM6DSL_SENSORHUB=true": [
            "lsm6dsl_shub.c",
        ],
    }),
    hdrs = glob(
        ["*.h"],
        allow_empty = True,
    ),
)
